# Aplicação
APP_NAME=Firewall Voucher Middleware - Hotspot
APP_VERSION=1.0.0
DEBUG=true
API_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# JWT - ALTERAR EM PRODUÇÃO!
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production-min-32-chars-long
